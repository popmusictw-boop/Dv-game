# 正式環境必填：以下三把金鑰請用指令產生，存放於伺服器，不放入版本控制
# python -c "import secrets;print(secrets.token_hex(32))"
BT_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
BT_DATA_KEY=
BT_ENV=production
BT_SESSION_SECURE=1          # 透過 HTTPS 提供服務時設為 1
BT_SESSION_HOURS=8
BT_RETENTION_DAYS=365        # 草稿與學生檔案保存天數（最後修改起算）
BT_MAX_UPLOAD_MB=20
BT_OCR_LANG=chi_tra+eng
# 選用：外部 AI 輔助擷取（預設關閉；需教育局／學校同意資料送出後再開啟）
BT_AI_ENABLED=0
ANTHROPIC_API_KEY=
BT_AI_MODEL=claude-sonnet-5-5
